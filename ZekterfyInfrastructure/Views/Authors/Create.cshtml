@model ZekterfyDomain.Model.Author

@{
    ViewData["Title"] = "Create";
}

<h1>Додавання</h1>

<h4>Author</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Pseudonym" class="control-label"></label>
                <input asp-for="Pseudonym" class="form-control" />
                <span asp-validation-for="Pseudonym" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="birthdate" class="control-label"></label>
                <!-- Додали type="date", щоб браузер показував календар -->
                <input asp-for="birthdate" type="date" class="form-control" />
                <span asp-validation-for="birthdate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}