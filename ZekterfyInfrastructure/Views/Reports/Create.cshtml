@model ZekterfyDomain.Model.Report

<div class="container mt-5">
    <div class="card bg-dark text-white p-4 mx-auto" style="max-width: 500px; border-radius: 15px;">
        <h2 class="text-danger">🚩 Поскаржитись</h2>
        <p class="text-muted">Ви хочете надіслати скаргу на пісню: <strong>@ViewBag.SongName</strong></p>

        <form asp-action="Create" method="post">
            <input type="hidden" name="songId" value="@ViewBag.SongId" />
            
            <div class="form-group mb-3">
                <label class="form-label">Причина скарги:</label>
                <textarea name="reason" class="form-control bg-secondary text-white border-0" rows="4" placeholder="Напишіть, що не так з цією піснею..."></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger w-100">Надіслати</button>
                <a asp-controller="Songs" asp-action="Index" asp-route-id="0" class="btn btn-outline-light w-100">Скасувати</a>
            </div>
        </form>
    </div>
</div>