@model IEnumerable<ZekterfyDomain.Model.Report>

@{
    ViewData["Title"] = "Керування скаргами";
}

<div class="container mt-4">
    <h2 class="text-white mb-4">🚩 Скарги на пісні</h2>

    <table class="table spotify-table">
        <thead>
            <tr>
                <th>Дата</th>
                <th>Пісня</th>
                <th>Причина</th>
                <th>Користувач (ID)</th>
                <th>Статус</th>
                <th style="text-align: right;">Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr style="@(item.Status == true ? "opacity: 0.5;" : "")">
                    <td class="text-muted">@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="spotify-song-title">@(item.Song?.Name ?? "Пісню видалено")</td>
                    <td>@item.Reason</td>
                    <td class="small text-muted">@item.UserId</td>
                    <td>
                        @if (item.Status == true)
                        {
                            <span class="badge bg-success">Розглянуто</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Нова</span>
                        }
                    </td>
                    <td style="text-align: right;">
                        @if (item.Status != true)
                        {
                            <form asp-action="Resolve" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-success">Вирішено</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>