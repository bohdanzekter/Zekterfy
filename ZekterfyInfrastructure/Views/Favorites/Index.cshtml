@model IEnumerable<ZekterfyDomain.Model.Favorite>

@{
	ViewData["Title"] = "Улюблені";
}

<h1>Улюблені</h1>

<p>
	<a class="btn btn-primary rounded-pill" asp-controller="Songs" asp-action="Create">Додати нову пісню</a>
</p>
<table class="table spotify-table">
	<thead>
		<tr>
			<th>
			</th>
			<th>
			</th>
			<th>
			</th>
			<th>
			<th>
				@Html.DisplayNameFor(model => model.Added)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Song)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Song.GenreId)
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
				<tr>
					<td>
						<button class="btn btn-success rounded-circle btn-sm"
								onclick="MusicPlayer.addAndPlay(@item.Song.Id, '@item.Song.Name')">
							▶
						</button>
					</td>
					<td>
						<button class="btn btn-outline-warning rounded-circle btn-sm" title="Додати в чергу"
								onclick="MusicPlayer.addToQueue(@item.Song.Id, '@item.Song.Name')">
							➕
						</button>
					</td>
					<td>
						<a class="btn btn-outline-danger btn-sm rounded-circle"
							   style="width: 35px; height: 35px;"
							   title="Поскаржитись"
							   asp-controller="Reports" asp-action="Create" asp-route-songId="@item.Song.Id">
							🚩
						</a>
					</td>
				<td>
					@Html.DisplayFor(modelItem => item.Added)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Song.Name)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Song.GenreId)
				</td>
				<td>
					<div class="btn-group gap-2" role="group">
						<a class="btn btn-sm btn-outline-light" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
						<a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@item.Id">Details</a>
						<a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
					</div>
				</td>
			</tr>
		}
	</tbody>
</table>
