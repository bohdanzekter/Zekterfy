@model ZekterfyDomain.Model.Song

@{
    ViewData["Title"] = "Create";
}

<h1>Додавання пісні до жанру @ViewBag.GenreName</h1>

<h4>Song</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group mb-3">
                <label class="control-label text-white">Оберіть аудіофайл (.mp3)</label>
                <input type="file" name="audioFile" class="form-control bg-dark text-white" accept="audio/*" required />
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Оберіть автора (Обов'язково)</label>
                <select name="authorId" class="form-control" asp-items="ViewBag.AuthorList">
                    <option value="">-- Виберіть автора --</option>
                </select>
            </div>
            <div class="form-group mb-3">
                <label asp-for="AlbumId" class="control-label"></label>
                <select asp-for="AlbumId" class="form-control" asp-items="ViewBag.AlbumList">
                    <option value="">Створити новий однойменний альбом (Сингл)</option>
                </select>
            </div>
            <div class="form-group mb-3">
                <label asp-for="GenreId" class="control-label"></label>
                <select asp-for="GenreId" class="form-control" asp-items="ViewBag.GenresList">
                    <option value="">Виберіть жанр зі списку</option>
                </select>
    
                <span asp-validation-for="GenreId" class="text-danger"></span>
            </div>
            <input type="hidden" value="@ViewBag.GenreName" name="GenreName" />

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
