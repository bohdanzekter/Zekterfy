@model IEnumerable<ZekterfyDomain.Model.Song>

@{
	ViewData["Title"] = "Пісні";
}

<h1>Пісні @ViewBag.GenreName</h1>

@if (User.IsInRole("admin") || User.IsInRole("author"))
{
	<p>
		<a class="btn btn-primary rounded-pill" asp-controller="Songs" asp-action="Create">Додати нову пісню</a>
	</p>
}

<table class="table spotify-table">
	<thead>
		<tr>
			<th>
			</th>
			<th>
			</th>
			<th>
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Lenght)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.NumOfStreams)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Name)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Genre.Name)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Album)
			</th>
			<th>
				Автор
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>
					<button class="btn btn-success rounded-circle btn-sm"
							onclick="MusicPlayer.addAndPlay(@item.Id, '@item.Name')">
						▶
					</button>
				</td>
				<td>
					<button class="btn btn-outline-warning rounded-circle btn-sm" title="Додати в чергу"
							onclick="MusicPlayer.addToQueue(@item.Id, '@item.Name')">
						➕
					</button>
				</td>
				<td>
					<a class="btn btn-outline-danger btn-sm rounded-circle"
						   style="width: 35px; height: 35px;"
						   title="Поскаржитись"
						   asp-controller="Reports" asp-action="Create" asp-route-songId="@item.Id">
						🚩
					</a>
				</td>
				<td>
					@(item.Lenght.Value / 60):@((item.Lenght.Value % 60).ToString("00"))
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.NumOfStreams)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Name)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Genre.Name)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Album.Name)
				</td>
				<td>
					@{
						var allLinks = ViewBag.SongAuthors as IEnumerable<ZekterfyDomain.Model.SongAuthor>;
        
						var authorsOfThisSong = allLinks?
							.Where(sa => sa.SongId == item.Id)
							.Select(sa => sa.Author.Pseudonym);
            
						string authorsText = authorsOfThisSong != null && authorsOfThisSong.Any()
							? string.Join(", ", authorsOfThisSong)
							: "Невідомий автор";
					}
    
					<span class="text-info fw-bold">@authorsText</span>
				</td>
				<td>
					<div class="btn-group gap-2" role="group">
						<a class="btn btn-sm btn-outline-light" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
						<a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@item.Id">Details</a>
						<a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
					</div>
				</td>
			</tr>
		}
	</tbody>
</table>
