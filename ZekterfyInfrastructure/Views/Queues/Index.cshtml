@model IEnumerable<ZekterfyDomain.Model.Queue>

@{
	ViewData["Title"] = "Черга";
}

<h1>Черга</h1>
<div class="container mt-4">
    <h2 class="text-white mb-4">🎶 Черга відтворення</h2>

    <table class="table spotify-table" style="border-radius: 10px; overflow: hidden;">
        <thead> 
            <tr>
                <th style="width: 50px;">#</th>
                <th>Назва пісні</th>
                <th style="width: 100px;">Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-muted">@item.Position</td>
                    <td class="fw-bold">@item.Song.Name</td>
                    <td>
                        <button class="btn btn-sm btn-success rounded-circle"
                                onclick="MusicPlayer.addAndPlay(@item.Song.Id, '@item.Song.Name')">
                            ▶
                        </button>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="m-0">
                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Видалити з черги">
                                ❌
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
